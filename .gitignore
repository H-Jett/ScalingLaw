# ---- 生成物(体积大或可复现, 不入库) ----
models/                 # make_model_ladder.py 生成的各尺寸 config(config+tokenizer, 无权重)
logs/                   # 训练日志(scripts/train_abl.py)
runs/                   # 每个 run 的配置/预算/checkpoint/曲线(scripts/train_abl.py 的产出)
outputs/
saves/
data/*
!data/dataset_info.json # 语料配置要入库, 语料本体不入库

# ---- Python ----
__pycache__/
*.py[cod]
.venv/
